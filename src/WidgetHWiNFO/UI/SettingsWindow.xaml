<Window x:Class="WidgetHWiNFO.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:WidgetHWiNFO.UI"
        x:ClassModifier="internal"
        Title="{x:Static ui:Strings.Settings}"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,8,24,20">
        <TextBlock Text="{x:Static ui:Strings.ArrangePanel}" Style="{StaticResource Header}" />
        <DockPanel Margin="0,2,0,8">
            <TextBlock Text="{x:Static ui:Strings.PanelLayout}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox x:Name="Layout" Width="190" HorizontalAlignment="Right" SelectionChanged="OnLayoutChanged" />
        </DockPanel>
        <TextBlock Text="{x:Static ui:Strings.ArrangeHint}" Style="{StaticResource Hint}" />

        <ItemsControl x:Name="CardList">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type ui:CardRow}">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding Visible}" Content="{Binding Name}" VerticalAlignment="Center" Margin="0" />
                        <ComboBox Grid.Column="1" Width="130" Margin="8,0" VerticalAlignment="Center"
                                  ItemsSource="{x:Static ui:CardRow.ColumnOptions}" SelectedIndex="{Binding ColumnIndex}"
                                  IsEnabled="{Binding ColumnEnabled}" ToolTip="{x:Static ui:Strings.ColumnHint}" />
                        <Button Grid.Column="2" Content="&#xE70E;" Tag="{Binding}" Click="OnMoveUp" ToolTip="{x:Static ui:Strings.MoveUp}"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="34" Height="32" Padding="0" Margin="0,0,4,0" />
                        <Button Grid.Column="3" Content="&#xE70D;" Tag="{Binding}" Click="OnMoveDown" ToolTip="{x:Static ui:Strings.MoveDown}"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="34" Height="32" Padding="0" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Margin="0,6,0,0">
            <Hyperlink Click="OnResetCards"><Run Text="{x:Static ui:Strings.ResetDefault}" /></Hyperlink>
        </TextBlock>
        <CheckBox x:Name="ProcessesStartCollapsed" Content="{x:Static ui:Strings.ProcessesStartCollapsed}" Margin="0,10,0,2" />

        <TextBlock Text="{x:Static ui:Strings.General}" Style="{StaticResource Header}" />
        <DockPanel Margin="0,2,0,6">
            <TextBlock Text="{x:Static ui:Strings.UpdateInterval}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox x:Name="Interval" Width="150" HorizontalAlignment="Right" DisplayMemberPath="Label" />
        </DockPanel>
        <CheckBox x:Name="StartWithWindows" Content="{x:Static ui:Strings.StartWithWindows}" />
        <CheckBox x:Name="PinTrayIcons" Content="{x:Static ui:Strings.PinTrayIcons}" />
        <CheckBox x:Name="HideStoppedFans" Content="{x:Static ui:Strings.HideStoppedFans}" />

        <TextBlock Text="{x:Static ui:Strings.AdvancedHint}" Style="{StaticResource Hint}" Margin="0,16,0,4" />
        <TextBlock>
            <Hyperlink Click="OnOpenSettingsFile"><Run Text="{x:Static ui:Strings.OpenSettingsFile}" /></Hyperlink>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{x:Static ui:Strings.Save}" MinWidth="96" IsDefault="True" Click="OnSave" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0" />
            <!-- IsCancel only auto-closes modal dialogs; this window is modeless, so close explicitly. -->
            <Button Content="{x:Static ui:Strings.Cancel}" MinWidth="96" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
